{
  "expo": {
    "name": "Pulse Health",
    "slug": "pulse-health",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "pulsehealth",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#0D0F0E",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pulsehealth.app"
    },
    "android": {
      "package": "com.pulsehealth.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 200,
          "backgroundColor": "#0D0F0E"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enablePngCrunchInReleaseBuilds": true,
            "buildArchs": [
              "arm64-v8a",
              "armeabi-v7a"
            ]
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pulse Health uses your location to record a walking route while a walk is running. Location is not recorded in the background."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pulse Health reads a photo you choose so it can show it as your profile picture. The photo stays on this device."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Pulse Health uses motion data to count your steps. Your step data stays on this device."
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "0647a96c-26ab-4218-a99d-a652256cd8e4"
      }
    }
  }
}
